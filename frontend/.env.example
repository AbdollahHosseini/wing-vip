# Ask a lead for the staging Supabase project's values. Never commit .env.
# Your own project: both are in the Connect dialog, or Project Settings > API Keys.
VITE_SUPABASE_URL=
# The publishable key (sb_publishable_...); on older projects, the legacy anon key.
# Never the secret key (sb_secret_...) or the legacy service_role key: they
# bypass Row Level Security, and everything here ships in the public bundle.
VITE_SUPABASE_ANON_KEY=
