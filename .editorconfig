# Shared editor settings for every file in the repo: https://editorconfig.org
# JetBrains IDEs read this file as it is; VS Code needs the EditorConfig
# extension (recommended in .vscode/extensions.json).
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Two spaces at the end of a Markdown line are a line break: keep them.
[*.md]
trim_trailing_whitespace = false

# Windows batch files need CRLF, as .gitattributes says.
[*.{bat,cmd}]
end_of_line = crlf
